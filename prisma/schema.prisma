datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum AccountType {
  CHECKING
  SAVINGS
  CASH
  OTHER
}

enum TransactionType {
  INCOME
  OUTCOME
  TRANSFER
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
  OVERDUE
}

enum LoanType {
  I_OWE
  OWED_TO_ME
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts     Account[]
  creditCards  CreditCard[]
  categories   Category[]
  transactions Transaction[]
  goals        Goal[]
  budgets      Budget[]
  loans        Loan[]

  @@map("users")
}

model Bank {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String
  icon      String?
  createdAt DateTime @default(now())

  accounts    Account[]
  creditCards CreditCard[]

  @@map("banks")
}

model Account {
  id        String      @id @default(uuid())
  userId    String
  bankId    String
  name      String
  balance   Decimal     @default(0.00) @db.Decimal(15, 2)
  type      AccountType @default(CHECKING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank         Bank          @relation(fields: [bankId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId])
  @@map("accounts")
}

model CreditCard {
  id         String   @id @default(uuid())
  userId     String
  bankId     String
  name       String
  limit      Decimal  @db.Decimal(15, 2)
  closingDay Int
  dueDay     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank     Bank      @relation(fields: [bankId], references: [id], onDelete: Restrict)
  invoices Invoice[]

  @@unique([userId, name])
  @@index([userId])
  @@map("credit_cards")
}

model Invoice {
  id           String        @id @default(uuid())
  creditCardId String
  month        Int
  year         Int
  closingDate  DateTime
  dueDate      DateTime
  status       InvoiceStatus @default(OPEN)
  totalAmount  Decimal       @default(0.00) @db.Decimal(15, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  creditCard   CreditCard    @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([creditCardId, month, year])
  @@index([creditCardId, status])
  @@map("invoices")
}

model Category {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subcategories Subcategory[]
  transactions  Transaction[]
  budgets       Budget[]

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

model Subcategory {
  id         String   @id @default(uuid())
  categoryId String
  name       String
  createdAt  DateTime @default(now())

  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("subcategories")
}

model Transaction {
  id            String          @id @default(uuid())
  userId        String
  accountId     String?
  invoiceId     String?
  categoryId    String
  subcategoryId String?
  title         String
  amount        Decimal         @db.Decimal(15, 2)
  type          TransactionType
  date          DateTime
  isPaid        Boolean         @default(true)
  isRecurring   Boolean         @default(false)
  installmentGroup   String?
  currentInstallment Int?
  totalInstallments  Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, type])
  @@index([accountId])
  @@index([invoiceId])
  @@map("transactions")
}

model Goal {
  id           String        @id @default(uuid())
  userId       String
  title        String
  targetAmount Decimal       @db.Decimal(15, 2)
  savedAmount  Decimal       @default(0.00) @db.Decimal(15, 2)
  deadline     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deposits GoalDeposit[]

  @@unique([userId, title])
  @@index([userId])
  @@map("goals")
}

model GoalDeposit {
  id        String   @id @default(uuid())
  goalId    String
  amount    Decimal  @db.Decimal(15, 2)
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("goal_deposits")
}

model Budget {
  id          String   @id @default(uuid())
  userId      String
  categoryId  String
  limitAmount Decimal  @db.Decimal(15, 2)
  month       Int
  year        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
  @@index([userId, month, year])
  @@map("budgets")
}

model Loan {
  id               String   @id @default(uuid())
  userId           String
  title            String
  totalAmount      Decimal  @db.Decimal(15, 2)
  remainingAmount  Decimal  @db.Decimal(15, 2)
  installmentValue Decimal? @db.Decimal(15, 2)
  dueDate          DateTime?
  type             LoanType
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("loans")
}