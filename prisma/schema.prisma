datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS (Tipagens estritas de segurança)
// ==========================================

enum AccountType {
  CHECKING // Conta Corrente
  SAVINGS  // Poupança
  CASH     // Dinheiro físico / Carteira
  OTHER    // Outros investimentos ou saldos
}

enum TransactionType {
  INCOME   // Entrada (Receita)
  OUTCOME  // Saída (Despesa)
  TRANSFER // Transferência entre contas/metas
}

enum InvoiceStatus {
  OPEN     // Fatura aberta (em ciclo de compras)
  CLOSED   // Fatura fechada (aguardando pagamento)
  PAID     // Fatura paga
  OVERDUE  // Fatura em atraso
}

enum LoanType {
  I_OWE      // Eu devo dinheiro para alguém/instituição
  OWED_TO_ME // Alguém me deve dinheiro
}

// ==========================================
// ENTIDADES DO NÚCLEO (USUÁRIO E BANCOS)
// ==========================================

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relacionamentos (Um para Muitos)
  accounts     Account[]
  creditCards  CreditCard[]
  categories   Category[]
  transactions Transaction[]
  goals        Goal[]
  budgets      Budget[]
  loans        Loan[]

  @@map("users")
}

model Bank {
  id        String   @id @default(uuid())
  name      String   @unique // Evita cadastrar "Nubank" duas vezes
  color     String   // Ex: "#8A05BE" (Purple)
  icon      String?  // Ícone ou Logo (URL/Slug)
  createdAt DateTime @default(now())

  accounts    Account[]
  creditCards CreditCard[]

  @@map("banks")
}

// ==========================================
// CONTAS CORRENTES E CARTÕES DE CRÉDITO
// ==========================================

model Account {
  id        String      @id @default(uuid())
  userId    String
  bankId    String
  name      String      // Ex: "Conta Principal"
  balance   Decimal     @default(0.00) @db.Decimal(15, 2)
  type      AccountType @default(CHECKING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank         Bank          @relation(fields: [bankId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@unique([userId, name]) // Usuário não pode ter duas contas com nome idêntico
  @@index([userId])
  @@map("accounts")
}

model CreditCard {
  id         String   @id @default(uuid())
  userId     String
  bankId     String
  name       String   // Ex: "Nubank Ultravioleta"
  limit      Decimal  @db.Decimal(15, 2)
  closingDay Int      // Ex: 25
  dueDay     Int      // Ex: 05
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank     Bank      @relation(fields: [bankId], references: [id], onDelete: Restrict)
  invoices Invoice[]

  @@unique([userId, name])
  @@index([userId])
  @@map("credit_cards")
}

model Invoice {
  id           String        @id @default(uuid())
  creditCardId String
  month        Int           // 1 a 12
  year         Int           // Ex: 2026
  closingDate  DateTime      // Data de fechamento real calculada
  dueDate      DateTime      // Data de vencimento real calculada
  status       InvoiceStatus @default(OPEN)
  totalAmount  Decimal       @default(0.00) @db.Decimal(15, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  creditCard   CreditCard    @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([creditCardId, month, year]) // Impossível existir duas faturas para o mesmo mês/ano
  @@index([creditCardId, status])
  @@map("invoices")
}

// ==========================================
// CATEGORIAS E SUBCATEGORIAS
// ==========================================

model Category {
  id        String   @id @default(uuid())
  userId    String
  name      String   // Ex: "Lazer"
  color     String   // Ex: "#9B51E0"
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subcategories Subcategory[]
  transactions  Transaction[]
  budgets       Budget[]

  @@unique([userId, name]) // Nome da categoria deve ser único para o usuário
  @@index([userId])
  @@map("categories")
}

model Subcategory {
  id         String   @id @default(uuid())
  categoryId String
  name       String   // Ex: "Jogos Steam"
  createdAt  DateTime @default(now())

  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("subcategories")
}

// ==========================================
// O MOTOR: TRANSAÇÕES FINANCEIRAS
// ==========================================

model Transaction {
  id            String          @id @default(uuid())
  userId        String          // Facilita buscas globais sem JOINs pesados
  accountId     String?         // Preenchido se foi pago via Conta/Débito/PIX
  invoiceId     String?         // Preenchido se foi compra no Cartão de Crédito
  categoryId    String
  subcategoryId String?
  title         String          // Ex: "Stray na Steam", "Aluguel"
  amount        Decimal         @db.Decimal(15, 2)
  type          TransactionType
  date          DateTime
  isPaid        Boolean         @default(true)

  // Recorrências (Contas fixas ou assinaturas mensais)
  isRecurring   Boolean         @default(false)

  // Parcelamentos (Ex: 12x no cartão)
  installmentGroup   String?    // UUID para agrupar todas as parcelas da mesma compra
  currentInstallment Int?       // Ex: 1
  totalInstallments  Int?       // Ex: 12

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  // Índices compostos de alta performance (o que mais filtramos no app)
  @@index([userId, date])
  @@index([userId, type])
  @@index([accountId])
  @@index([invoiceId])
  @@map("transactions")
}

// ==========================================
// METAS E COFRINHOS (GOALS)
// ==========================================

model Goal {
  id           String        @id @default(uuid())
  userId       String
  title        String        // Ex: "Viagem SP 2027" ou "Fundo PC Gamer"
  targetAmount Decimal       @db.Decimal(15, 2)
  savedAmount  Decimal       @default(0.00) @db.Decimal(15, 2)
  deadline     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deposits GoalDeposit[]

  @@unique([userId, title])
  @@index([userId])
  @@map("goals")
}

model GoalDeposit {
  id        String   @id @default(uuid())
  goalId    String
  amount    Decimal  @db.Decimal(15, 2)
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("goal_deposits")
}

// ==========================================
// TETOS E ORÇAMENTOS (BUDGETS)
// ==========================================

model Budget {
  id          String   @id @default(uuid())
  userId      String
  categoryId  String
  limitAmount Decimal  @db.Decimal(15, 2) // Teto de gastos (Ex: 500.00)
  month       Int      // 1 a 12
  year        Int      // Ex: 2026
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year]) // Só existe 1 teto por categoria no mês/ano
  @@index([userId, month, year])
  @@map("budgets")
}

// ==========================================
// CONTROLE DE EMPRÉSTIMOS
// ==========================================

model Loan {
  id               String   @id @default(uuid())
  userId           String
  title            String   // Ex: "Empréstimo Notebook"
  totalAmount      Decimal  @db.Decimal(15, 2)
  remainingAmount  Decimal  @db.Decimal(15, 2)
  installmentValue Decimal? @db.Decimal(15, 2)
  dueDate          DateTime?
  type             LoanType
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("loans")
}